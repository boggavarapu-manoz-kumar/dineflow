# ==============================================================================
# DineFlow Staging Load-Test Environment Template (NEVER commit real tokens!)
# ==============================================================================
ALLOW_LOAD_TEST=true
BASE_URL=https://staging.dineflow.example.com
WS_URL=wss://staging.dineflow.example.com/ws
PROFILE=baseline
WS_VUS=5
WS_DURATION=1m

# Synthetic Staging Tenant A & B tokens (generated against isolated staging DB)
TENANT_A_STAFF_JWT=replace_with_synthetic_tenant_a_staff_jwt
TENANT_B_STAFF_JWT=replace_with_synthetic_tenant_b_staff_jwt
TENANT_A_GUEST_JWT=replace_with_synthetic_tenant_a_guest_jwt
TENANT_A_BILL_ID=00000000-0000-0000-0000-000000000000
