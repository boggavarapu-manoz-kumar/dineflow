# ==============================================================================
# DineFlow SaaS Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# NEVER commit real production secrets to Git.
# ==============================================================================

# Backend Port and Environment Profile (dev | test | prod)
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dineflow_db
DB_USER=dineflow_user
DB_PASSWORD=dineflow_secure_password
DB_SCHEMA=public
DB_SSL_MODE=prefer

# JWT & Security
JWT_SECRET=change_me_to_a_strong_256bit_secret_key_in_production
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Redis / Valkey (Distributed Rate Limiting & Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false
RATE_LIMIT_STORE=memory

# S3 / GCS-Compatible Object Storage (local | s3)
STORAGE_TYPE=local
S3_BUCKET=dineflow-assets
S3_REGION=ap-south-1
S3_ENDPOINT=http://localhost:9000
S3_PATH_STYLE=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Razorpay Payment Gateway (Use Sandbox Keys in Dev/Staging)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Scheduled Reconciliation (ShedLock)
RECONCILIATION_CRON=0 */5 * * * *

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_NAME=DineFlow
