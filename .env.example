# ==============================================================================
# DineFlow SaaS Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Backend Port and Environment Profile
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dineflow_db
DB_USER=dineflow_user
DB_PASSWORD=dineflow_secure_password
DB_SCHEMA=public

# CORS Configuration (Comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_NAME=DineFlow
